$OFFLISTING

* MPS/GE MODEL GENERATOR FILE

$OFFINLINE
$INLINECOM { }
PUT   MPS,'$MODEL:GTAP9'/;

{    2}  PUT /;
 
{    2}  PUT'$SECTORS:'/;
{    3}  LOOP((G,R)$(RM(R)*VOM(G,R)),
{    3}    PUT /,'Y''.'G.TL'.'R.TL;
{    3}  );
{    4}  LOOP((I,R)$(RM(R)*VIM(I,R)),
{    4}    PUT /,'M''.'I.TL'.'R.TL;
{    4}  );
