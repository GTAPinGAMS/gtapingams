{    5}    PUT /,'YT''.'J.TL;
{    5}  );
{    6}  LOOP((F,R)$(RM(R)*SF(F)*EVOM(F,R)),
{    6}    PUT /,'FT''.'F.TL'.'R.TL;
{    6}  );
{    7}  LOOP((I,R)$(RM(R)*CDE(R)*VCM(I,R)),
{    7}    PUT /,'A''.'I.TL'.'R.TL;
{    7}  );
{    8}  LOOP((I,R)$(VEM(I,R)),
{    8}    PUT /,'X''.'I.TL'.'R.TL;
{    8}  );
{   10}  PUT /;
 
{   10}  PUT'$COMMODITIES:'/;
{   11}  LOOP((G,R)$(RM(R)*(VOM(G,R)-VXM(G,R))),
{   11}    PUT /,'P''.'G.TL'.'R.TL;
{   11}  );
