 258          rowpfx          Rest of world endowment of foreign exchange,
 259          vem(g,r)        Bilateral exports outside model,
 260          rtxs_row(i,r)   Subsidies on exports to ROW,
 261          pem0(i,r)       Reference price of exports;
 262   
 263  set     rm(r)           Regions include in the model
 264          rx(r)           Regions excluded from the model;
 265   
 266  *       Default model is GMR, not SOE:
 267   
 268  rm(r) = yes;
 269  rx(r) = (not rm(r));
 270  rowpfx = sum(rx(r), vom("c",r));
 271  vem(i,rm(r)) = sum(rx(s),vxmd(i,r,s));
 272  rtxs_row(i,r) = (sum(rx(s),vxmd(i,r,s)*rtxs(i,r,s))/vem(i,r))$vem(i,r);
 273  pem0(i,r) = (1-rtxs_row(i,r));
 274   
 275   
 276   
 277  set     cde(r)          Regions with CDE demand,
 278          les(r)          Regions with LES demand,
 279          cd(r)           Regions with CD or CES demand;
 280   
 281  cde(r) = no;
 282  les(r) = no;
 283  cd(r) = yes;
 284   
      $model:gtap9
       
      $sectors:
      	Y(g,r)$(rm(r)*vom(g,r))		! Supply
      	M(i,r)$(rm(r)*vim(i,r))		! Imports
      	YT(j)$vtw(j)			! Transportation services
      	FT(f,r)$(rm(r)*sf(f)*evom(f,r))	! Specific factor transformation
      	A(i,r)$(rm(r)*cde(r)*vcm(i,r))	! Armington final demand quantity index (CDE model)
      	X(i,r)$vem(i,r)			! Exports to or from rest of world (SOE model)
       
      $commodities:
      	P(g,r)$(rm(r)*(vom(g,r)-vxm(g,r)))		! Domestic output price
      	PE(g,r)$(rx(r)*vem(g,r)+rm(r)*vxm(g,r))		! Export market
      	PM(j,r)$(rm(r)*vim(j,r))			! Import price
      	PT(j)$vtw(j)					! Transportation services
      	PF(f,r)$(rm(r)*evom(f,r))			! Primary factors rent
      	PS(f,g,r)$(rm(r)*sf(f)*vfm(f,g,r))		! Sector-specific primary factors
      	PFX$card(rx)					! Real exchange rate (SOE model)
      	PA(i,r)$(rm(r)*cde(r)*vcm(i,r))			! Armington final demand price
       
      $consumers:
      	RA(r)$rm(r)		! Representative agent
      	ROW$card(rx)		! Rest of world (SOE model)
       
      $auxiliary:
      	D(i,r)$(rm(r)*cde(r)*vcm(i,r)) ! Demand (index)
GAMS 24.7.1  r56632 Released Mar 14, 2016 WEX-WEI x86 64bit/MS Windows                                                                                                                                                                 12/30/16 11:35:47 Page 8
GAMS Code to Read a GTAP 9 Dataset
