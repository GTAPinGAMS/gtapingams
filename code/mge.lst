  99          eta(i,r)        Income elasticity of demand,
 100          epsilon(i,r)    Own-price elasticity of demand,
 101          thetac(i,r)     Value share of commodity i in final demand,
 102          aues(i,j,r)     Allen-Uzawa elasticities of substitution;
 103   
--- LOAD  incpar = 25:incpar
--- LOAD  subpar = 26:subpar
--- LOAD  eta = 23:eta
--- LOAD  aues = 24:aues
 105   
 106  thetac(i,r) = (vdfm(i,"c",r)*(1+rtfd(i,"c",r)) + vifm(i,"c",r)*(1+rtfi(i,"c",r))) /
 107           sum(j,vdfm(j,"c",r)*(1+rtfd(j,"c",r)) + vifm(j,"c",r)*(1+rtfi(j,"c",r)));
 108   
 109  epsilon(i,r) = aues(i,i,r)*thetac(i,r);
 110   
 111  set     fyr     Years in the GDP and population forecast /2010*2030/,
 112          fitem   Forecast items /gdp, pop/;
 113   
 114  parameter       forecast(r,fitem,fyr)   GTAP regional population and GDP forecast;
 115   
--- LOAD  forecast = 33:forecast
 118   
 119  *       Declare some intermediate arrays which are required to
 120  *       evaluate tax rates:
 121   
 122  parameter       vdm(g,r)        Aggregate demand for domestic output,
 123                  vom(g,r)        Total supply at market prices;
 124   
 125  *       LES demand system:
 126   
 127  parameter
 128          betales(r)      Non-subsistence expenditure share,
 129          sigmales(r)     Elasticity of substitution in the LES model,
 130          vcm(i,r)        CDE demand vector;
 131   
 133   
 134  betales(r) = sum(i, thetac(i,r)*epsilon(i,r))/sum(i,eta(i,r)*thetac(i,r)*(eta(i,r)*thetac(i,r)-1));
 135  sigmales(r) = (1/betales(r)) * sum(i, thetac(i,r)*epsilon(i,r))/sum(i,eta(i,r)*thetac(i,r)*(eta(i,r)*thetac(i,r)-1));
 136   
 137  *       Elasticity of substitution in final demand:
 138   
 139  parameter       esub(g,r)       Top-level elasticity;
 140   
 141  esub(i,r) = esubt(i);
 142   
 143  esub("c",r) = 1;
 144  esub("sd",r) = 0;
 145  esub("dd",r) = sigmales(r);
 146   
 147  *       CDE demand system:
 148   
 149  vcm(i,r) = vdfm(i,"c",r)*(1+rtfd(i,"c",r)) + vifm(i,"c",r)*(1+rtfi(i,"c",r));
 150   
GAMS 24.7.1  r56632 Released Mar 14, 2016 WEX-WEI x86 64bit/MS Windows                                                                                                                                                                 12/30/16 11:35:47 Page 5
