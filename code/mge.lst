  76   
  77  *       Apply common rates on LES demand:
  78   
  79  rto(lesd,r) = rto("c",r);
  80  rtfd(i,lesd,r) = rtfd(i,"c",r);
  81  rtfi(i,lesd,r) = rtfi(i,"c",r);
  82   
  83  parameter
  84          esubt(i)        Elasticity of top-level input substitution',
  85          esubd(i)        Elasticity of substitution (M versus D),
  86          esubva(g)       Elasticity of substitution between factors,
  87          esubm(i)        Intra-import elasticity of substitution,
  88          etrae(f)        Elasticity of transformation;
  89   
--- LOAD  esubt = 18:esubt
--- LOAD  esubd = 19:esubd
--- LOAD  esubva = 20:esubva
--- LOAD  esubm = 21:esubm
--- LOAD  etrae = 22:etrae
  91   
  92  *       Avoid numerical problems with high elasticities:
  93   
  94  esubd(i) = min(8,esubd(i));
  95   
  96  parameter
  97          incpar(i,r)     Expansion parameter in the CDE expenditure function,
  98          subpar(i,r)     Substitution parameter in CDE expenditure function,
