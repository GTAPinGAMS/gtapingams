 151  vom("c",r) = sum(i, vdfm(i,"c",r)*(1+rtfd(i,"c",r)) + vifm(i,"c",r)*(1+rtfi(i,"c",r)))/(1-rto("c",r));
 152  vom("g",r) = sum(i, vdfm(i,"g",r)*(1+rtfd(i,"g",r)) + vifm(i,"g",r)*(1+rtfi(i,"g",r)))/(1-rto("g",r));
 153  vom("i",r) = sum(i, vdfm(i,"i",r)*(1+rtfd(i,"i",r)) + vifm(i,"i",r)*(1+rtfi(i,"i",r)))/(1-rto("i",r));
 154   
 155  vdm(i,r) = sum(g,vdfm(i,g,r));
 156  vom(i,r) = vdm(i,r) + sum(s, vxmd(i,r,s)) + vst(i,r);
 157   
 158  parameter
 159          rtf0(f,g,r)     Primary factor and commodity rates taxes
 160          rtfd0(i,g,r)    Firms domestic tax rates
 161          rtfi0(i,g,r)    Firms' import tax rates
 162          rtxs0(i,r,s)    Export subsidy rates
 163          rtms0(i,r,s)    Import taxes rates;
 164   
 165  rtf0(f,g,r) = rtf(f,g,r);
 166  rtfd0(i,g,r) = rtfd(i,g,r);
 167  rtfi0(i,g,r) = rtfi(i,g,r);
 168   
 169  rtf0(f,lesd,r) = rtf(f,"c",r);
 170  rtfd0(i,lesd,r) = rtfd(i,"c",r);
 171  rtfi0(i,lesd,r) = rtfi(i,"c",r);
 172   
 173  rtxs0(i,r,s) = rtxs(i,r,s);
 174  rtms0(i,r,s) = rtms(i,r,s);
 175   
 176  parameter       pvxmd(i,s,r)    Import price (power of benchmark tariff)
 177                  pvtwr(i,s,r)    Import price for transport services;
 178   
 179  pvxmd(i,s,r) = (1+rtms0(i,s,r)) * (1-rtxs0(i,s,r));
 180  pvtwr(i,s,r) = 1+rtms0(i,s,r);
 181   
 182  parameter
 183          vtw(j)          Aggregate international transportation services,
 184          vpm(r)          Aggregate private demand,
 185          vgm(r)          Aggregate public demand,
 186          vim(i,r)        Aggregate imports,
 187          evom(f,r)       Aggregate factor endowment at market prices,
 188          vb(r)           Current account balance
 189          vbchksum        Check of aggregate income balance;
 190   
 191  vtw(j) = sum(r, vst(j,r));
 192  vom("c",r) = sum(i, vdfm(i,"c",r)*(1+rtfd0(i,"c",r)) + vifm(i,"c",r)*(1+rtfi0(i,"c",r)))/(1-rto("c",r));
 193  vom("g",r) = sum(i, vdfm(i,"g",r)*(1+rtfd0(i,"g",r)) + vifm(i,"g",r)*(1+rtfi0(i,"g",r)))/(1-rto("g",r));
 194  vom("i",r) = sum(i, vdfm(i,"i",r)*(1+rtfd0(i,"i",r)) + vifm(i,"i",r)*(1+rtfi0(i,"i",r)))/(1-rto("i",r));
 195   
 196  vdm("c",r) = vom("c",r);
 197  vdm("g",r) = vom("g",r);
 198  vdm("i",r) = vom("i",r);
 199  vim(i,r) =  sum(g, vifm(i,g,r));
 200  evom(f,r) = sum(g, vfm(f,g,r));
 201  vb(r) = vom("c",r) + vom("g",r) + vom("i",r)
 202          - sum(f, evom(f,r))
 203          - sum(g,  vom(g,r)*rto(g,r))
GAMS 24.7.1  r56632 Released Mar 14, 2016 WEX-WEI x86 64bit/MS Windows                                                                                                                                                                 12/30/16 11:35:47 Page 6
