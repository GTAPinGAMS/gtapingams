  16  set     g(*)    Goods plus C - SD - DD -- G and I;
GDXIN   d:\Bruno\paper_gtap\submission\GAMSCode\gamsdata\2011\g20_macro.gdx
--- LOAD  g = 3:g
  20   
  21  set     i(g)    Goods
