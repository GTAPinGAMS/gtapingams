 879  $macro pnum(r)          (sum(i_, P.L(i_,r)*vdfm(i_,"c",r)+PM.L(i_,r)*vifm(i_,"c",r))/sum(i_,vdfm(i_,"c",r)+vifm(i_,"c",r)))
 880  $macro DFM(f,g,r)       (V_FM.L(f,g,r)$(rm(r)*vom(g,r)*vfm(f,g,r)))
 881  $macro DDFM(i,g,r)      (V_DFM.L(i,g,r) + V_VDA.L(i,r)$(vcm(i,r) and sameas(g,"c")))
 882  $macro DIFM(i,g,r)      (V_IFM.L(i,g,r) + V_VIA.L(i,r)$(vcm(i,r) and sameas(g,"c")))
 883  $macro REV_TO(g,r)      ((rto(g,r)*((P.L(g,r)*V_VDM.L(g,r))$(vom(g,r)-vxm(g,r))+(PE.L(g,r)*v_vxm.L(g,r))$vxm(g,r)))$(rm(r)*vom(g,r)))
 884  $macro REV_TFD(i,g,r)   (rtfd(i,g,r) * P.L(i,r)  * DDFM(i,g,r))
 885  $macro REV_TFI(i,g,r)   (rtfi(i,g,r) * PM.L(i,r) * DIFM(i,g,r))
 886  $macro REV_TF(f,g,r)    ((rtf(f,g,r)  * v_fm.L(f,g,r) * ((PS.L(f,g,r))$sf(f)+(PF.L(f,r))$mf(f)))$(rm(r)*vom(g,r)*vfm(f,g,r)))
 887  $macro XMD(i,s,r)       ((V_XMD.L(i,s,r)/vxmd(i,s,r))$(rm(r)*vim(i,r)*vxmd(i,s,r)) + X.L(i,s)$(rm(s) and rx(r) and vxmd(i,s,r)))
 888  $macro PX(i,r)          ((P.L(i,r)$(not vxm(i,r)) + PE.L(i,r)$vxm(i,r))$rm(r) + PE.L(i,r)$rx(r))
 889  $macro REV_TXS(i,s,r)   ((XMD(i,s,r)*rtxs(i,s,r)*vxmd(i,s,r) * PX(i,s))$(rm(s)*vxmd(i,s,r)*rtxs(i,s,r)))
 890  $macro REV_TMS(i,s,r)   ((XMD(i,s,r)*rtms(i,s,r)*(PX(i,s)*(1-rtxs(i,s,r))*vxmd(i,s,r)  + \
 891                           sum(j_$vtwr(j_,i,s,r), PT.L(j_)*vtwr(j_,i,s,r))))$(rm(r)*vxmd(i,s,r)*rtms(i,s,r)))
