  36   
  37  set             vtcomp /ad      "Anti-dumping duty",
  38                          mfa     "Export tax equivalent of MFA quota premia",
  39                          pu      "Export tax equivalent of price undertakings",
  40                          ver     "Export tax equivalent of voluntary export restraints",
  41                          xt      "Ordinary export tax"
  42                          tarif   "Ordinary import duty",
  43                          adv     "Import tariff revenue - levied on an ad-valorem basis",
  44                          spe     "Import tariff revenue - levied on a specific basis" /
  45   
  46  parameters
  47          vfm(f,g,r)      Endowments - Firms' purchases at market prices,
  48          vdfm(i,g,r)     Intermediates - firms' domestic purchases at market prices,
  49          vifm(i,g,r)     Intermediates - firms' imports at market prices,
  50          vxmd(i,r,s)     Trade - bilateral exports at market prices,
  51          vst(i,r)        Trade - exports for international transportation
  52          vtwr(i,j,r,s)   Trade - Margins for international transportation at world prices,
  53          vtrev(vtcomp,i,r,s)     Components of trade taxes;
