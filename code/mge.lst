 204          - sum(g,  sum(i, vdfm(i,g,r)*rtfd(i,g,r) + vifm(i,g,r)*rtfi(i,g,r)))
 205          - sum(g,  sum(f, vfm(f,g,r)*rtf(f,g,r)))
 206          - sum((i,s), rtms(i,s,r) *  (vxmd(i,s,r) * (1-rtxs(i,s,r)) + sum(j,vtwr(j,i,s,r))))
 207          + sum((i,s), rtxs(i,r,s) * vxmd(i,r,s));
 208  vbchksum = sum(r, vb(r));
 209  display vbchksum;
 210   
 211  *       Determine which factors are sector-specific
 212   
 213  mf(f) = yes$(1/etrae(f)=0);
 214  sf(f) = yes$(1/etrae(f)>0);
 215  display etrae, mf,sf;
 216   
 217  parameter       mprofit Zero profit for m,
 218                  yprofit Zero profit for y;
 219   
 220  mprofit(i,r) = round(vim(i,r) - sum(s, pvxmd(i,s,r)*vxmd(i,s,r)+sum(j, vtwr(j,i,s,r))*pvtwr(i,s,r)),3);
 221  display mprofit;
 222   
 223  yprofit(g,r) = 0;
 224  yprofit(g,r)$vom(g,r) = round(vom(g,r)*(1-rto(g,r))
 225          - sum(i, vdfm(i,g,r)*(1+rtfd0(i,g,r)) + vifm(i,g,r)*(1+rtfi0(i,g,r)))
 226          - sum(f, vfm(f,g,r)*(1+rtf0(f,g,r))),3);
 227  display yprofit;
 228   
 229  *       Define a numeraire region for denominating international
 230  *       transfers:
 231   
 232  rnum(r) = yes$(vom("c",r)=smax(s,vom("c",s)));
 233  display rnum;
 234   
 235  *       Export supply elasticity:
 236   
 237  parameter       etadx(g)        Export elasticity of transformation D vs E,
 238                  esubdm(i)       Elasticity of substitution D vs M,
 239                  vxm(g,r)        Export market supply;
 240   
 242  etadx(i)$(1-0.5) = esubd(i)/(1-0.5);
 243  etadx(i)$(not (1-0.5)) = +inf;
 244  esubdm(i) = esubd(i)/0.5;
 245  vxm(i,s) = (vst(i,s) + sum(r,vxmd(i,s,r)))$(1/etadx(i));
 246   
 247  parameter       gtapelasticities        Database elasticities;
 248  gtapelasticities(i,"esubt") = esubt(i);
 249  gtapelasticities(i,"etadx") = etadx(i);
 250  gtapelasticities(i,"esubm") = esubm(i);
 251  gtapelasticities(i,"esubva") = esubva(i);
 252  gtapelasticities(i,"esubd") = esubd(i);
 253  display gtapelasticities;
 254   
 255  *       Small open economy framework:
 256   
 257  parameter
GAMS 24.7.1  r56632 Released Mar 14, 2016 WEX-WEI x86 64bit/MS Windows                                                                                                                                                                 12/30/16 11:35:47 Page 7
GAMS Code to Read a GTAP 9 Dataset
